# ------------------------------------------------------------
# 🧹 FICHIERS DE DEVELOPPEMENT (a ne pas versionner)
# ------------------------------------------------------------
# Dossiers de conversion temporaires
temp-lingala/
temp-kituba/
temp-bible-repo/
*.zip

# Scripts de conversion (garde-les en local, pas sur GitHub)
convert_*.py
fix_*.py
diag_*.py

# Sauvegardes
*.backup
*.bak

# ------------------------------------------------------------
# FICHIERS TEMPORAIRES DE DEVELOPPEMENT
# ------------------------------------------------------------

# Sources brutes de traductions (on garde les JSON convertis)
frontend/public/translations/*-test.json
frontend/public/translations/temp-list.txt
frontend/public/translations/*.v1
frontend/public/translations/clean_*.py
frontend/public/translations/ru_synod.json
frontend/public/translations/zh_cunpss-shen.json
frontend/public/translations/temp-*.txt

# Fichiers de test
test_*.py
test.json
diagnostic_*.py

# Fichiers lourds / obsolètes
frelsg.bbl.mybible.gz
zerlon.xml

# Sources bibliques brutes (archive locale, pas nécessaire au runtime)
frelsg.bbl.mybible.gz
*.mybible.gz
